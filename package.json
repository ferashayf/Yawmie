{
  "name": "yawmie",
  "description": "Yawmie (يومي): your day and money in one calm place. iPhone web app, Arabic and English, data stays on your phone.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferashayf/Yawmie.git"
  },
  "homepage": "https://yawmie.me",
  "scripts": {
    "dev": "vite apps/app",
    "build": "tsc --noEmit -p apps/app && vite build apps/app",
    "build:artifact": "tsc --noEmit -p apps/app && vite build apps/app --mode artifact",
    "preview": "vite preview apps/app",
    "test": "vitest run --root apps/app && node --test 'tooling/scripts/*.test.mjs'",
    "check:privacy": "node tooling/scripts/check-privacy.mjs",
    "prepare": "git config core.hooksPath tooling/githooks || true"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
